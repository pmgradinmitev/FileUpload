@model PaintingViewModel

<h2>@(Model.Id != null ? $"Редактирай категория: {Model.Name}" : "Създай категория")</h2>

<form asp-controller="Painting" asp-action="@(Model.Id != null ? "Update" : "Create")" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />

    <div class="row">
        <div class="col-8 d-flex flex-column">
            <!-- your input fields here -->
            <div class="row mb-3 p-1">
                <label asp-for="Name" class="p-0"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="row mb-3 p-1">
                <label asp-for="Author" class="p-0"></label>
                <input asp-for="Author" class="form-control" />
                <span asp-validation-for="Author" class="text-danger"></span>
            </div>
            <div class="row mb-3 p-1">
                <label asp-for="Description" class="p-0"></label>
                <textarea asp-for="Description" class="form-control" rows="5" cols="50"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="row mb-3 p-1">
                <label asp-for="File" class="p-0"></label>
                <input id="image-input" asp-for="File" class="form-control border-0" style="padding-left:25px;" />
                <span asp-validation-for="File" class="text-danger"></span>
            </div>
            <div class="row justify-content-begin">
                <div class="col-4">
                    <button type="submit" class="btn btn-primary form-control">@(Model.Id != null ? "Редактирай" : "Създай")</button>
                </div>
                <div class="col-4">
                    <a asp-controller="Painting" asp-action="Index" class="btn btn-outline-secondary form-control">Към списъка</a>
                </div>
            </div>
        </div>

        <div class="col-4 d-flex align-items-stretch">
            <div class="w-100" style="border:1px solid #bbb9b9; border-radius:5px; overflow:hidden;">
                <img id="thumbnail-image"
                     src="@Url.Content(String.IsNullOrEmpty(Model.ImagePath) ? "~/" + FileUtils.GetEmptyImagePath() : "~/" + Model.ImagePath)"
                     style="width:100%; height:100%; object-fit:cover;" />
            </div>
        </div>
    </div>
</form>
